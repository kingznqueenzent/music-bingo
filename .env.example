# =============================================================================
# LyricGrid — environment variables
# Copy to `.env.local` for local dev. Production: Vercel → Settings → Environment Variables
# Or run: npm run vercel:env-push  (pushes catalog defaults from .env.local)
# Catalog source: config/vercel-env.js
# =============================================================================

# --- REQUIRED (Vercel Production) ---------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://dmcjpkrdivafkqoovyvn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Enables proxy guard for /host, /media-manager, /playlists, etc.
ADMIN_EMAIL=you@venue.com

# Host subscription tier: free (hosting only) | pro (media library) | enterprise (media + branding)
# Production venues with media library access should set pro or enterprise.
HOST_TIER=enterprise
NEXT_PUBLIC_HOST_TIER=enterprise

# Pre-launch: unset or false keeps shared room code LYRIC for testing.
# Set to true at launch for secure random 6-character room codes.
NEXT_PUBLIC_IS_LIVE=false
# IS_LIVE=true

# --- RECOMMENDED --------------------------------------------------------------
# Legacy admin password login at /admin-login
# ADMIN_SECRET=long-random-secret

# Supabase → Database → Connection string (Session pooler, port 5432)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# YouTube Data API v3 — playlist import at /host/import-youtube
# YOUTUBE_API_KEY=

# Prize / venue email (Resend)
# CLAIMED_PRIZE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=LyricGrid <noreply@lyricgrid.ca>
# PRIZE_CLAIM_NOTIFY_TO=
# VENUE_BOOKING_NOTIFY_TO=

# Kingz marketing canonical URL
# NEXT_PUBLIC_KINGZ_SITE_URL=https://lyricgrid.ca

# Mix analyzer FastAPI (optional)
# MIX_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=

# Spotify search (optional)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
